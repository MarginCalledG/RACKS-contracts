# Copy to /opt/racks-keeper/.env, chmod 600, owner keeper.
# This file holds the keeper private key. It is the only secret here —
# chain.json is NOT a secret (see N-50 in AUDIT.md), only an availability asset.

# A DEDICATED endpoint. The public one is rate limited and not meant for production;
# during the testnet deploy it dropped out after 29 of 35 transactions.
RPC=https://<dedicated-endpoint>

# Keeper wallet. Its own wallet, used by nothing else: while the bot is running, any manual
# transaction from the same address fails on the nonce.
KEY=0x<keeper-private-key>

SEED=0x<HashChainSeed>
AGENT=0x<IRSAgent>
RACKS=0x<Racks>
VAULT=0x<CaymanIslands>

CHAIN=/opt/racks-keeper/chain.json
STATE=/opt/racks-keeper/keeper-state.json

# 60 s is comfortable: the freeze window is 256 parent-chain blocks (~40-55 min, N-45), and the
# binding cadence is the vault's 30-minute expiry bucket, not the freeze window.
TICK_MS=60000

# Minimum accrual before a pool melt is worth a transaction. A full day of silence deviates by
# 0 bps (N-47), so half an hour is far inside the lossless range.
MELT_MIN_S=1800

# Warn below this ETH balance. At roughly 12 USD/month of gas, 0.01 ETH is about a quarter of a
# year of run-up — enough to react to a warning calmly rather than at 3am.
LOW_GAS=0.01
